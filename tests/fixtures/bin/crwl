#!/usr/bin/env bash
set -euo pipefail

# A tiny fake Crawl4AI CLI for tests.
# It supports:
# - crwl --help
# - crwl crawl --help
# - crwl crawl <url> ... -o all ... [--deep-crawl bfs --max-pages N --max-depth D]

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "fake crwl (tests)"
  exit 0
fi

if [[ "${1:-}" == "crawl" && ("${2:-}" == "--help" || "${2:-}" == "-h") ]]; then
  echo "fake crwl crawl (tests)"
  exit 0
fi

if [[ "${1:-}" != "crawl" ]]; then
  echo "unexpected command: $*" 1>&2
  exit 2
fi

url="${2:-}"
if [[ -z "${url}" ]]; then
  echo "missing url" 1>&2
  exit 2
fi

attempt_state_file="${CRWL_STATE_FILE:-}"
attempt_count=1
if [[ -n "${attempt_state_file}" ]]; then
  mkdir -p "$(dirname "${attempt_state_file}")"
  if [[ -f "${attempt_state_file}" ]]; then
    attempt_count="$(cat "${attempt_state_file}")"
    attempt_count=$((attempt_count + 1))
  fi
  printf '%s' "${attempt_count}" > "${attempt_state_file}"
fi

sleep_seconds="${CRWL_SLEEP_SECONDS:-0}"
sleep_match="${CRWL_SLEEP_MATCH:-}"
if [[ -n "${sleep_match}" && "${url}" == *"${sleep_match}"* ]]; then
  sleep "${sleep_seconds}"
fi

fail_until="${CRWL_FAIL_UNTIL_ATTEMPT:-0}"
fail_match="${CRWL_FAIL_MATCH:-}"
if [[ -n "${fail_match}" && "${url}" == *"${fail_match}"* ]]; then
  if [[ "${attempt_count}" -le "${fail_until}" ]]; then
    echo "simulated transient failure on attempt ${attempt_count}" 1>&2
    exit 1
  fi
fi

deep="0"
for arg in "$@"; do
  if [[ "${arg}" == "--deep-crawl" ]]; then
    deep="1"
  fi
done

base="${url}"
if [[ "${base}" != */ ]]; then
  base="${base}/"
fi

root_url="${url%%#*}"
child_suffix="${CRWL_CHILD_PATH:-guide}"
child_url="${base}${child_suffix}"

root_md="# Docs\n\nThis is a deterministic fake Crawl4AI markdown output for tests. Tavily and Gemini help agents crawl docs.\n"
child_md="# Guide\n\nSecond page content for deep crawl tests. It also mentions agents and crawl.\n"

if [[ "${deep}" == "1" ]]; then
  cat <<JSON
[
  {
    "url": "${root_url}",
    "metadata": {"title": "Docs", "status": 200, "url": "${root_url}"},
    "markdown": {"raw_markdown": "${root_md}", "fit_markdown": "${root_md}"},
    "links": {
      "internal": [
        {"href": "${child_url}"},
        {"href": "${base}assets/logo.png"}
      ],
      "external": [
        {"href": "https://external.example.com/"}
      ]
    }
  },
  {
    "url": "${child_url}",
    "metadata": {"title": "Guide", "status": 200, "url": "${child_url}"},
    "markdown": {"raw_markdown": "${child_md}", "fit_markdown": "${child_md}"},
    "links": {"internal": [], "external": []}
  }
]
JSON
  exit 0
fi

cat <<JSON
[
  {
    "url": "${root_url}",
    "metadata": {"title": "Docs", "status": 200, "url": "${root_url}"},
    "markdown": {"raw_markdown": "${root_md}", "fit_markdown": "${root_md}"},
    "links": {"internal": [{"href": "${child_url}"}], "external": []}
  }
]
JSON
